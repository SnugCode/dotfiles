configuration {
    modes:               "drun,calc";
    font:                "Inter 14";
    display-drun:        "";
    display-calc:        "";
    show-icons:          true;
    icon-theme:          "breeze-dark";
    drun-display-format: "{name}";
}

* {
    text-color:        #FFFFFF;
    background-color:  transparent;
}

window {
    location:          north;
    anchor:            north;
    x-offset:          0px;
    y-offset:          220px;
    width:             620px;
    background-color:  rgba(18, 18, 28, 0.78);
    border:            1px solid;
    border-color:      rgba(255, 255, 255, 0.22);
    border-radius:     16px;
    padding:           0px;
}

mainbox {
    orientation:       vertical;
    spacing:           0px;
    padding:           0px;
    children:          [ "inputbar", "separator", "listview" ];
}

inputbar {
    padding:           14px 18px;
    spacing:           10px;
    children:          [ "prompt", "entry" ];
    background-color:  transparent;
}

prompt {
    font:              "0xProto Nerd Font Mono 15";
    text-color:        rgba(255, 255, 255, 0.4);
    vertical-align:    0.5;
    expand:            false;
}

entry {
    font:              "Inter 15";
    text-color:        #FFFFFF;
    placeholder:       "Search apps...";
    placeholder-color: rgba(255, 255, 255, 0.3);
    vertical-align:    0.5;
    expand:            true;
    cursor:            text;
}

separator {
    height:            1px;
    expand:            false;
    background-color:  rgba(255, 255, 255, 0.1);
    margin:            0px 14px;
}

listview {
    padding:           8px 0px;
    scrollbar:         false;
    lines:             8;
    spacing:           0px;
    fixed-height:      false;
    background-color:  transparent;
}

element {
    padding:           9px 14px;
    spacing:           12px;
    border-radius:     10px;
    margin:            2px 8px;
    orientation:       horizontal;
    children:          [ element-icon, element-text ];
    background-color:  transparent;
    cursor:            pointer;
}

element normal.normal {
    background-color:  transparent;
}

element selected.normal {
    background-color:  rgba(255, 255, 255, 0.1);
}

element alternate.normal {
    background-color:  transparent;
}

element-icon {
    size:              26px;
    vertical-align:    0.5;
    background-color:  transparent;
}

element-text {
    font:              "Inter 13";
    text-color:        #FFFFFF;
    vertical-align:    0.5;
    background-color:  transparent;
    highlight:         bold rgba(255, 255, 255, 0.9);
}
