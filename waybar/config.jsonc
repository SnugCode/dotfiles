{
    // Positioning
    "layer": "top",
    "height": 25,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,
    
    // Apply CSS on Change
    "reload_style_on_change": true,

    // Module Order
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "custom/protonvpn", "bluetooth", "custom/localsend", "custom/pipewire", "custom/media", "battery"],
    
    // Module Configuration
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "",
            "5": ""
        }
    },
    "hyprland/window": {
    	"format": "{}",
    	"separate-outputs": true,
    	"max-length": 50
    },
    "clock": {
        "timezone": "Australia/Melbourne",
	"format": "{:%H:%M | %d %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "custom/media": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "cider": "",
            "default": "🎜"
        },
        "escape": true,
        "exec": "~/.config/waybar/scripts/mediaplayer.py 2> /dev/null", 
        "on-click": "~/.config/waybar/scripts/media-menu.py"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠", 
	    "tooltip-format": "{essid}", 
	    "on-click": "~/.config/waybar/scripts/wifi-menu.py"
    },
    "custom/protonvpn": {
        "format": "{}",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "exec": "~/.config/waybar/scripts/protonvpn-status.py",
        "on-click": "~/.config/waybar/scripts/protonvpn-menu.py"
    },
    "bluetooth": {
        "format": "󰂲",
        "format-on": "{icon}",
        "format-off": "{icon}", 
        "format-connected":"{icon}",
        "format-icons":{
            "on":"󰂯",
            "off": "󰂲",
            "connected": "󰂱"
        },
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.py",
        "tooltip-format-on": "Not Connected",
        "tooltip-format-off": "Not Connected",
        "tooltip-format-connected": "{device_alias}"
    },
    "custom/localsend": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "LocalSend",
        "on-click": "~/.config/waybar/scripts/localsend-menu.py"
    },
    "custom/pipewire": {
	    "format": "{}",
        "return-type": "json",
        "signal": 8,
        "interval": 30,
        "format-icons": {
            "mute": "", 
	    "default": ["", "", ""]
	    },
	    "exec": "~/.config/waybar/scripts/pipewire-status.sh",
	    "on-click": "~/.config/waybar/scripts/volume-slider.py"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "full-at": 80,
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-plugged": "", 
        "tooltip-format-charging": "Charging: {capacity}%",
	    "tooltip-format": "{capacity}%"
    }
}
