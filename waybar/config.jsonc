{
    // Positioning
    "layer": "top",
    "height": 25,
    "margin-top": 8,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 4,
    
    // Apply CSS on Change
    "reload_style_on_change": true,

    // Module Order
    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["network", "bluetooth", "custom/pipewire", "custom/media", "battery"],
    
    // Module Configuration
    "hyprland/workspaces": {
        "format": "{icon}",
        "format-icons": {
            "1": "",
            "2": "",
            "3": "",
            "4": "󰉋",
            "5": ""
        },
        "persistent-workspaces": {
            "*": 5
        }
    },
    "custom/workspaces": {
        "exec": "~/.config/waybar/scripts/workspaces.sh",
        "format": "{}",
        "return-type": "json",
        "escape": false,
        "on-click": "hyprctl dispatch workspace e+1",
        "on-click-right": "hyprctl dispatch workspace e-1"
    },
    "hyprland/window": {
    	"format": "{}",
    	"separate-outputs": true
    },
    "clock": {
        "timezone": "Australia/Melbourne",
	"format": "{:%H:%M | %d %b %Y}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}"
    },
    "custom/media": {
        "format": "{text}",
        "return-type": "json",
        "max-length": 40,
        "format-icons": {
            "spotify": "󰓇",
            "default": "🎜"
        },
        "escape": true,
        "exec": "~/.config/waybar/scripts/mediaplayer.py 2> /dev/null", 
        "on-click": "~/.config/waybar/scripts/media-menu.py"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-disconnected": "Disconnected ⚠", 
	    "tooltip-format": "{essid}", 
	    "on-click": "~/.config/waybar/scripts/wifi-menu.py"
    },
    "bluetooth": {
        "format": "󰂲",
        "format-on": "{icon}",
        "format-off": "{icon}", 
        "format-connected":"{icon}",
        "format-icons":{
            "on":"󰂯",
            "off": "󰂲",
            "connected": "󰂱"
        },
        "on-click": "~/.config/waybar/scripts/bluetooth-menu.py",
        "tooltip-format-on": "Not Connected",
        "tooltip-format-off": "Not Connected",
        "tooltip-format-connected": "{device_alias}"
    },
    "custom/pipewire": {
	    "format": "{}",
        "return-type": "json",
        "signal": 8,
        "interval": 2,
        "format-icons": {
            "mute": "", 
	    "default": ["", "", ""]
	    },
	    "exec": "~/.config/waybar/scripts/pipewire-status.sh",
	    "on-click": "~/.config/waybar/scripts/volume-slider.py"
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 15
        },
        "full-at": 80,
        "format": "{icon}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ],
        "format-plugged": "", 
        "tooltip-format-charging": "Charging: {capacity}%",
	    "tooltip-format": "{capacity}%"
    }
}
