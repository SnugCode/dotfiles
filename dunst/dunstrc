[global]
    monitor = 0
    follow = none

    ### Geometry ###
    width = 360
    height = (0, 300)
    origin = top-right
    offset = (16, 46)
    scale = 0
    notification_limit = 5

    ### Progress bar ###
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 2
    progress_bar_corners = all

    ### Icons ###
    icon_corner_radius = 6
    icon_corners = all

    indicate_hidden = yes
    separator_height = 0
    padding = 14
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 1
    gap_size = 8
    separator_color = frame
    sort = urgency_descending

    ### Text ###
    font = Inter 12
    line_height = 3
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = no

    ### Icons ###
    enable_recursive_icon_lookup = true
    icon_theme = breeze-dark
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48

    ### History ###
    sticky_history = yes
    history_length = 20

    ### Misc ###
    browser = /usr/bin/xdg-open
    always_run_script = true
    corner_radius = 14
    corners = all
    ignore_dbusclose = false

    ### Wayland ###
    layer = overlay
    force_xwayland = false

    ### Mouse ###
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true

[urgency_low]
    background = "#12121CBF"
    foreground = "#88889999"
    frame_color = "#FFFFFF18"
    timeout = 8
    default_icon = dialog-information

[urgency_normal]
    background = "#12121CC7"
    foreground = "#FFFFFFFF"
    frame_color = "#FFFFFF38"
    timeout = 10
    default_icon = dialog-information

[urgency_critical]
    background = "#12121CC7"
    foreground = "#FFFFFFFF"
    frame_color = "#E05C5CFF"
    timeout = 0
    default_icon = dialog-warning
