{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/logo.txt",
    "type": "file-raw",
    "padding": {
      "right": 2
    }
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 12
    },
    "size": {
      "ndigits": 1,
      "spaceBeforeUnit": "never"
    }
  },
  "modules": [
    {
      "type": "title",
      "keyColor": "cyan"
    },
    {
      "type": "custom",
      "format": "{#90}────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣇 distro",
      "keyColor": "cyan"
    },
    {
      "type": "kernel",
      "key": " kernel",
      "keyColor": "cyan",
      "format": "{release}"
    },
    {
      "type": "packages",
      "key": "󰏖 pkgs",
      "keyColor": "cyan",
      "combined": true
    },
    {
      "type": "uptime",
      "key": "󰅐 uptime",
      "keyColor": "cyan"
    },
    "break",
    {
      "type": "wm",
      "key": " session",
      "keyColor": "green"
    },
    {
      "type": "custom",
      "key": " terminal",
      "keyColor": "green",
      "format": "kitty"
    },
    {
      "type": "custom",
      "key": " term font",
      "keyColor": "green",
      "format": "0xProto Nerd Font Mono"
    },
    {
      "type": "shell",
      "key": " shell",
      "keyColor": "green"
    },
    "break",
    {
      "type": "host",
      "key": "󰌢 machine",
      "keyColor": "blue"
    },
    {
      "type": "cpu",
      "key": "󰻠 cpu",
      "keyColor": "blue"
    },
    {
      "type": "gpu",
      "key": "󰍛 gpu",
      "keyColor": "blue",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "󰑭 memory",
      "keyColor": "blue",
      "format": "{used} / {total}"
    },
    {
      "type": "disk",
      "key": " disk",
      "keyColor": "blue",
      "format": "{size-used} / {size-total} ({size-percentage}) - {filesystem}"
    },
    {
      "type": "display",
      "key": "󰍹 panel",
      "keyColor": "blue",
      "compactType": "original"
    },
    "break",
    {
      "type": "battery",
      "key": " battery",
      "keyColor": "yellow"
    },
    {
      "type": "media",
      "key": "󰝚 media",
      "keyColor": "yellow"
    },
    {
      "type": "localip",
      "key": "󰩟 network",
      "keyColor": "yellow"
    },
    "break",
    "colors"
  ]
}
