{
    "explorer.confirmDelete": false,
    "editor.fontFamily": "'0xProto Nerd Font Mono'",
    "editor.fontSize": 13,
    "editor.lineHeight": 1.45,
    "editor.cursorBlinking": "smooth",
    "editor.cursorStyle": "line",
    "editor.renderLineHighlight": "gutter",
    "editor.minimap.enabled": false,
    "terminal.integrated.fontFamily": "'0xProto Nerd Font Mono'",
    "terminal.integrated.fontSize": 12,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.scrollback": 10000,
    "terminal.integrated.smoothScrolling": true,
    "terminal.integrated.copyOnSelection": true,
    "terminal.integrated.defaultLocation": "panel",
    "terminal.integrated.shellIntegration.enabled": true,
    "terminal.integrated.tabs.enabled": true,
    "terminal.integrated.tabs.location": "right",
    "terminal.integrated.enableMultiLinePasteWarning": "auto",
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "zsh": {
            "path": "/usr/bin/zsh",
            "icon": "terminal",
            "env": {
                "COLORTERM": "truecolor",
                "TERM": "xterm-256color"
            }
        }
    },
    "window.titleBarStyle": "custom",
    "window.commandCenter": false,
    "telemetry.telemetryLevel": "off",
    "telemetry.enableTelemetry": false,
    "telemetry.enableCrashReporter": false,
    "workbench.enableExperiments": false,
    "workbench.settings.enableNaturalLanguageSearch": false,
    "workbench.tips.enabled": false,
    "workbench.welcomePage.walkthroughs.openOnInstall": false,
    "extensions.ignoreRecommendations": true,
    "extensions.showRecommendationsOnlyOnDemand": true,
    "extensions.autoCheckUpdates": false,
    "extensions.autoUpdate": "off",
    "update.mode": "none",
    "git.autofetch": false,
    "npm.fetchOnlinePackageInfo": false,
    "typescript.surveys.enabled": false,
    "workbench.colorTheme": "Dark Modern",
    "workbench.iconTheme": "vs-seti",
    "workbench.sideBar.location": "left",
    "workbench.secondarySideBar.defaultVisibility": true,
    "workbench.editor.showTabs": "multiple",
    "workbench.editor.tabSizing": "shrink",
    "workbench.editor.pinnedTabSizing": "compact",
    "workbench.editor.decorations.badges": true,
    "workbench.editor.decorations.colors": true,
    "workbench.startupEditor": "none",
    "workbench.tree.indent": 12,
    "workbench.tree.renderIndentGuides": "none",
    "workbench.layoutControl.enabled": false,
    "breadcrumbs.enabled": false,
    "files.associations": {
        "*.rasi": "css",
        "hyprland.conf": "ini",
        "hypridle.conf": "ini",
        "hyprlock.conf": "ini",
        "hyprpaper.conf": "ini",
        "kitty.conf": "properties"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 4
    },
    "[css]": {
        "editor.defaultFormatter": "vscode.css-language-features",
        "editor.formatOnSave": true,
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.wordWrap": "off"
    },
    "[shellscript]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.formatOnSave": false
    },
    "[markdown]": {
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 88,
        "editor.quickSuggestions": {
            "comments": "off",
            "strings": "off",
            "other": "off"
        }
    },
    "[ignore]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.wordWrap": "off"
    },
    "chatgpt.openOnStartup": true,
