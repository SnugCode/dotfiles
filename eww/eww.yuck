(defvar bt-popup-visible false)

(defvar audio-popup-visible false)

(defpoll volume-data
  :interval "1s"
  :run-while audio-popup-visible
  :initial `{"volume": 50, "muted": false, "icon": "", "percent": "50%"}`
  `~/.config/eww/scripts/volume-data.sh`)

(defpoll media-data
  :interval "2s"
  :run-while audio-popup-visible
  :initial `{"has_player": false, "player": "", "player_icon": "󰝚", "title": "Nothing playing", "artist": "", "album": "", "status": "Stopped", "status_icon": "󰐊", "progress": 0, "position_str": "0:00", "length_str": "0:00", "length_us": 0}`
  `~/.config/eww/scripts/media-data.py`)

(defpoll bt-data
  :interval "2s"
  :run-while bt-popup-visible
  :initial `{
  "powered": false,
  "has_devices": false,
  "has_available": false,
  "d0": {"visible": false, "name": "", "mac": "", "type_icon": "", "connected": false, "status": "", "action_label": ""},
  "d1": {"visible": false, "name": "", "mac": "", "type_icon": "", "connected": false, "status": "", "action_label": ""},
  "d2": {"visible": false, "name": "", "mac": "", "type_icon": "", "connected": false, "status": "", "action_label": ""},
  "d3": {"visible": false, "name": "", "mac": "", "type_icon": "", "connected": false, "status": "", "action_label": ""},
  "av0": {"visible": false, "name": "", "mac": "", "type_icon": ""},
  "av1": {"visible": false, "name": "", "mac": "", "type_icon": ""},
  "av2": {"visible": false, "name": "", "mac": "", "type_icon": ""},
  "av3": {"visible": false, "name": "", "mac": "", "type_icon": ""}
}`
  `~/.config/eww/scripts/bt-data.py`)

(defvar bt-scanning false)

(defpoll ls-data
  :interval "2s"
  :run-while bt-popup-visible
  :initial `{
  "running": false,
  "has_devices": false,
  "has_incoming": false,
  "ls0": {"visible": false, "id": "", "alias": "", "type_icon": ""},
  "ls1": {"visible": false, "id": "", "alias": "", "type_icon": ""},
  "ls2": {"visible": false, "id": "", "alias": "", "type_icon": ""},
  "ls3": {"visible": false, "id": "", "alias": "", "type_icon": ""},
  "inc0": {"visible": false, "id": "", "sender": "", "files": ""},
  "inc1": {"visible": false, "id": "", "sender": "", "files": ""}
}`
  `~/.config/eww/scripts/ls-data.py`)

(defwindow bluetooth
  :monitor 0
  :geometry (geometry :x "-8px" :y "34px" :anchor "top right" :width "280px")
  :stacking "fg"
  :focusable false
  (bt-menu))

(defwidget bt-menu []
  (box :class "bt-menu" :orientation "v" :spacing 10 :space-evenly false

    ; Header — always at top, never moves
    (box :class "bt-header" :orientation "h" :spacing 12 :space-evenly false
      (label :class "bt-title" :text "Bluetooth"
             :hexpand true :halign "start" :valign "center")
      (button :class {bt-data.powered ? "bt-toggle on" : "bt-toggle off"}
              :valign "center"
              :onclick `~/.config/eww/scripts/bt-power.sh ${bt-data.powered}`
        (label :text {bt-data.powered ? "On" : "Off"})))

    ; Device list — only shown when BT is on
    (box :visible {bt-data.powered} :orientation "v" :spacing 6 :space-evenly false

      ; Paired devices
      (box :visible {bt-data.d0.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {bt-data.d0.type_icon} :valign "center")
        (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
          (label :class "device-name" :text {bt-data.d0.name} :halign "start" :limit-width 20)
          (label :class {bt-data.d0.connected ? "device-status on" : "device-status"}
                 :text {bt-data.d0.status} :halign "start"))
        (button :class {bt-data.d0.connected ? "device-btn disconnect" : "device-btn"}
                :valign "center"
                :onclick `~/.config/eww/scripts/bt-toggle-device.sh "${bt-data.d0.mac}" ${bt-data.d0.connected}`
          (label :text {bt-data.d0.action_label})))

      (box :visible {bt-data.d1.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {bt-data.d1.type_icon} :valign "center")
        (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
          (label :class "device-name" :text {bt-data.d1.name} :halign "start" :limit-width 20)
          (label :class {bt-data.d1.connected ? "device-status on" : "device-status"}
                 :text {bt-data.d1.status} :halign "start"))
        (button :class {bt-data.d1.connected ? "device-btn disconnect" : "device-btn"}
                :valign "center"
                :onclick `~/.config/eww/scripts/bt-toggle-device.sh "${bt-data.d1.mac}" ${bt-data.d1.connected}`
          (label :text {bt-data.d1.action_label})))

      (box :visible {bt-data.d2.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {bt-data.d2.type_icon} :valign "center")
        (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
          (label :class "device-name" :text {bt-data.d2.name} :halign "start" :limit-width 20)
          (label :class {bt-data.d2.connected ? "device-status on" : "device-status"}
                 :text {bt-data.d2.status} :halign "start"))
        (button :class {bt-data.d2.connected ? "device-btn disconnect" : "device-btn"}
                :valign "center"
                :onclick `~/.config/eww/scripts/bt-toggle-device.sh "${bt-data.d2.mac}" ${bt-data.d2.connected}`
          (label :text {bt-data.d2.action_label})))

      (box :visible {bt-data.d3.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {bt-data.d3.type_icon} :valign "center")
        (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
          (label :class "device-name" :text {bt-data.d3.name} :halign "start" :limit-width 20)
          (label :class {bt-data.d3.connected ? "device-status on" : "device-status"}
                 :text {bt-data.d3.status} :halign "start"))
        (button :class {bt-data.d3.connected ? "device-btn disconnect" : "device-btn"}
                :valign "center"
                :onclick `~/.config/eww/scripts/bt-toggle-device.sh "${bt-data.d3.mac}" ${bt-data.d3.connected}`
          (label :text {bt-data.d3.action_label})))

      (label :visible {!bt-data.has_devices} :class "no-devices"
             :text "No paired devices" :halign "start")

      ; Separator before scan button
      (box :class "separator")

      ; Scan button
      (button :class {bt-scanning ? "scan-btn scanning" : "scan-btn"}
              :onclick `~/.config/eww/scripts/bt-scan.sh`
        (label :text {bt-scanning ? "Scanning..." : "Scan for Devices"}))

      ; Available (discovered) devices — shown after a scan
      (box :visible {bt-data.has_available} :orientation "v" :spacing 4 :space-evenly false
        (label :class "section-label" :text "Available" :halign "start")

        (box :visible {bt-data.av0.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
          (label :class "device-icon nerd" :text {bt-data.av0.type_icon} :valign "center")
          (label :class "device-name" :text {bt-data.av0.name}
                 :hexpand true :halign "start" :valign "center" :limit-width 20)
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/bt-pair.sh "${bt-data.av0.mac}"`
            (label :text "Pair")))

        (box :visible {bt-data.av1.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
          (label :class "device-icon nerd" :text {bt-data.av1.type_icon} :valign "center")
          (label :class "device-name" :text {bt-data.av1.name}
                 :hexpand true :halign "start" :valign "center" :limit-width 20)
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/bt-pair.sh "${bt-data.av1.mac}"`
            (label :text "Pair")))

        (box :visible {bt-data.av2.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
          (label :class "device-icon nerd" :text {bt-data.av2.type_icon} :valign "center")
          (label :class "device-name" :text {bt-data.av2.name}
                 :hexpand true :halign "start" :valign "center" :limit-width 20)
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/bt-pair.sh "${bt-data.av2.mac}"`
            (label :text "Pair")))

        (box :visible {bt-data.av3.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
          (label :class "device-icon nerd" :text {bt-data.av3.type_icon} :valign "center")
          (label :class "device-name" :text {bt-data.av3.name}
                 :hexpand true :halign "start" :valign "center" :limit-width 20)
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/bt-pair.sh "${bt-data.av3.mac}"`
            (label :text "Pair")))))

    ; ── LocalSend ────────────────────────────────────────────
    (box :class "separator")

    (box :orientation "h" :spacing 12 :space-evenly false
      (label :class "bt-title" :text "LocalSend"
             :hexpand true :halign "start" :valign "center")
      (button :class {ls-data.running ? "bt-toggle on" : "bt-toggle off"}
              :valign "center"
              :onclick `~/.config/eww/scripts/ls-toggle.sh ${ls-data.running}`
        (label :text {ls-data.running ? "On" : "Off"})))

    (box :visible {ls-data.running} :orientation "v" :spacing 6 :space-evenly false

      (label :visible {!ls-data.has_devices} :class "no-devices"
             :text "No nearby devices" :halign "start")

      (box :visible {ls-data.ls0.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {ls-data.ls0.type_icon} :valign "center")
        (label :class "device-name" :text {ls-data.ls0.alias}
               :hexpand true :halign "start" :valign "center" :limit-width 18)
        (button :class "device-btn" :valign "center"
                :onclick `~/.config/eww/scripts/ls-send.sh "${ls-data.ls0.id}"`
          (label :text "Send")))

      (box :visible {ls-data.ls1.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {ls-data.ls1.type_icon} :valign "center")
        (label :class "device-name" :text {ls-data.ls1.alias}
               :hexpand true :halign "start" :valign "center" :limit-width 18)
        (button :class "device-btn" :valign "center"
                :onclick `~/.config/eww/scripts/ls-send.sh "${ls-data.ls1.id}"`
          (label :text "Send")))

      (box :visible {ls-data.ls2.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {ls-data.ls2.type_icon} :valign "center")
        (label :class "device-name" :text {ls-data.ls2.alias}
               :hexpand true :halign "start" :valign "center" :limit-width 18)
        (button :class "device-btn" :valign "center"
                :onclick `~/.config/eww/scripts/ls-send.sh "${ls-data.ls2.id}"`
          (label :text "Send")))

      (box :visible {ls-data.ls3.visible} :class "device-row" :orientation "h" :spacing 10 :space-evenly false
        (label :class "device-icon nerd" :text {ls-data.ls3.type_icon} :valign "center")
        (label :class "device-name" :text {ls-data.ls3.alias}
               :hexpand true :halign "start" :valign "center" :limit-width 18)
        (button :class "device-btn" :valign "center"
                :onclick `~/.config/eww/scripts/ls-send.sh "${ls-data.ls3.id}"`
          (label :text "Send")))

      (box :visible {ls-data.has_incoming} :orientation "v" :spacing 4 :space-evenly false
        (label :class "section-label" :text "Incoming" :halign "start")

        (box :visible {ls-data.inc0.visible} :class "device-row" :orientation "h" :spacing 6 :space-evenly false
          (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
            (label :class "device-name" :text {ls-data.inc0.sender} :halign "start" :limit-width 14)
            (label :class "device-status" :text {ls-data.inc0.files} :halign "start" :limit-width 20))
          (button :class "accept-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/ls-decide.sh accept "${ls-data.inc0.id}"`
            (label :text "✓"))
          (button :class "device-btn disconnect" :valign "center"
                  :onclick `~/.config/eww/scripts/ls-decide.sh reject "${ls-data.inc0.id}"`
            (label :text "✗")))

        (box :visible {ls-data.inc1.visible} :class "device-row" :orientation "h" :spacing 6 :space-evenly false
          (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
            (label :class "device-name" :text {ls-data.inc1.sender} :halign "start" :limit-width 14)
            (label :class "device-status" :text {ls-data.inc1.files} :halign "start" :limit-width 20))
          (button :class "accept-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/ls-decide.sh accept "${ls-data.inc1.id}"`
            (label :text "✓"))
          (button :class "device-btn disconnect" :valign "center"
                  :onclick `~/.config/eww/scripts/ls-decide.sh reject "${ls-data.inc1.id}"`
            (label :text "✗")))))))

; ── Network + VPN popup ──────────────────────────────────────────────────────

(defvar network-popup-visible false)

(defpoll network-data
  :interval "3s"
  :run-while network-popup-visible
  :initial `{"wifi_enabled": false, "net_icon": "", "connected_ssid": "", "connected_signal": 0, "connected_signal_str": "", "has_known": false, "has_available": false, "k0": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "k1": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "k2": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "a0": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "a1": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "a2": {"visible": false, "ssid": "", "signal": 0, "signal_str": "", "icon": ""}, "vpn_connected": false, "vpn_server": ""}`
  `~/.config/eww/scripts/network-data.sh`)

(defwindow network
  :monitor 0
  :geometry (geometry :x "-8px" :y "34px" :anchor "top right" :width "270px")
  :stacking "fg"
  :focusable false
  (network-menu))

(defwidget network-menu []
  (box :class "bt-menu" :orientation "v" :spacing 10 :space-evenly false

    ; WiFi header
    (box :orientation "h" :spacing 12 :space-evenly false
      (label :class "bt-title" :text "WiFi"
             :hexpand true :halign "start" :valign "center")
      (button :class {network-data.wifi_enabled ? "bt-toggle on" : "bt-toggle off"}
              :valign "center"
              :onclick `~/.config/eww/scripts/wifi-toggle.sh ${network-data.wifi_enabled}`
        (label :text {network-data.wifi_enabled ? "On" : "Off"})))

    ; WiFi off label
    (label :visible {!network-data.wifi_enabled}
           :class "no-devices" :text "WiFi is off" :halign "start")

    ; WiFi content
    (box :visible {network-data.wifi_enabled} :orientation "v" :spacing 6 :space-evenly false

      ; Connected network
      (box :visible {network-data.connected_ssid != ""} :orientation "h" :spacing 8 :space-evenly false
        (label :class "nerd net-icon" :text {network-data.net_icon} :valign "center")
        (label :class "device-name" :text {network-data.connected_ssid}
               :hexpand true :halign "start" :valign "center" :limit-width 16)
        (label :class {network-data.connected_signal > 66 ? "sig-strong" : network-data.connected_signal > 33 ? "sig-medium" : "sig-weak"}
               :text {network-data.connected_signal_str} :valign "center"))
      (label :visible {network-data.connected_ssid == ""}
             :class "no-devices" :text "Not connected" :halign "start")

      ; Saved networks
      (box :visible {network-data.has_known} :orientation "v" :spacing 4 :space-evenly false
        (box :class "separator")
        (label :class "section-label" :text "Saved" :halign "start")

        (box :visible {network-data.k0.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.k0.icon} :valign "center")
          (label :class "device-name" :text {network-data.k0.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.k0.signal > 66 ? "sig-strong" : network-data.k0.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.k0.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.k0.ssid}" saved`
            (label :text "Connect")))

        (box :visible {network-data.k1.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.k1.icon} :valign "center")
          (label :class "device-name" :text {network-data.k1.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.k1.signal > 66 ? "sig-strong" : network-data.k1.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.k1.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.k1.ssid}" saved`
            (label :text "Connect")))

        (box :visible {network-data.k2.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.k2.icon} :valign "center")
          (label :class "device-name" :text {network-data.k2.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.k2.signal > 66 ? "sig-strong" : network-data.k2.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.k2.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.k2.ssid}" saved`
            (label :text "Connect"))))

      ; Available networks
      (box :visible {network-data.has_available} :orientation "v" :spacing 4 :space-evenly false
        (box :class "separator")
        (label :class "section-label" :text "Available" :halign "start")

        (box :visible {network-data.a0.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.a0.icon} :valign "center")
          (label :class "device-name" :text {network-data.a0.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.a0.signal > 66 ? "sig-strong" : network-data.a0.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.a0.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.a0.ssid}" available`
            (label :text "Connect")))

        (box :visible {network-data.a1.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.a1.icon} :valign "center")
          (label :class "device-name" :text {network-data.a1.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.a1.signal > 66 ? "sig-strong" : network-data.a1.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.a1.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.a1.ssid}" available`
            (label :text "Connect")))

        (box :visible {network-data.a2.visible} :class "device-row" :orientation "h" :spacing 8 :space-evenly false
          (label :class "nerd net-icon" :text {network-data.a2.icon} :valign "center")
          (label :class "device-name" :text {network-data.a2.ssid}
                 :hexpand true :halign "start" :valign "center" :limit-width 13)
          (label :class {network-data.a2.signal > 66 ? "sig-strong" : network-data.a2.signal > 33 ? "sig-medium" : "sig-weak"}
                 :text {network-data.a2.signal_str} :valign "center")
          (button :class "device-btn" :valign "center"
                  :onclick `~/.config/eww/scripts/wifi-connect.sh "${network-data.a2.ssid}" available`
            (label :text "Connect")))))

    ; VPN section
    (box :visible {network-data.wifi_enabled} :orientation "v" :spacing 8 :space-evenly false
      (box :class "separator")

      (box :orientation "h" :spacing 12 :space-evenly false
        (label :class "bt-title" :text "VPN"
               :hexpand true :halign "start" :valign "center")
        (button :class {network-data.vpn_connected ? "bt-toggle on" : "bt-toggle off"}
                :valign "center"
                :onclick `~/.config/eww/scripts/vpn-toggle.sh ${network-data.vpn_connected}`
          (label :text {network-data.vpn_connected ? "On" : "Off"})))

      ; Connected — show server info
      (label :visible {network-data.vpn_connected}
             :class "device-status on" :text {network-data.vpn_server} :halign "start")

      ; Disconnected — quick connect options
      (box :visible {!network-data.vpn_connected} :orientation "v" :spacing 6 :space-evenly false
        (box :orientation "h" :spacing 6 :space-evenly false
          (button :class "vpn-quick-btn" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh fastest`
            (label :text "Fastest"))
          (button :class "vpn-quick-btn" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh p2p`
            (label :text "P2P")))

        (label :class "vpn-cat-label" :text "Streaming" :halign "start")
        (box :orientation "h" :spacing 6 :space-evenly false
          (button :class "vpn-country-btn streaming" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh US`
            (label :text "US"))
          (button :class "vpn-country-btn streaming" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh CA`
            (label :text "CA"))
          (button :class "vpn-country-btn streaming" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh JP`
            (label :text "JP")))

        (label :class "vpn-cat-label" :text "Torrenting" :halign "start")
        (box :orientation "h" :spacing 6 :space-evenly false
          (button :class "vpn-country-btn torrent" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh SG`
            (label :text "SG"))
          (button :class "vpn-country-btn torrent" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh RO`
            (label :text "RO"))
          (button :class "vpn-country-btn torrent" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh ES`
            (label :text "ES")))

        (label :class "vpn-cat-label" :text "Privacy" :halign "start")
        (box :orientation "h" :spacing 6 :space-evenly false
          (button :class "vpn-country-btn privacy" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh CH`
            (label :text "CH"))
          (button :class "vpn-country-btn privacy" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh IS`
            (label :text "IS"))
          (button :class "vpn-country-btn privacy" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh PA`
            (label :text "PA")))

        (label :class "vpn-cat-label" :text "Misc" :halign "start")
        (box :orientation "h" :spacing 6 :space-evenly false
          (button :class "vpn-country-btn misc" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh LK`
            (label :text "LK"))
          (button :class "vpn-country-btn misc" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh PG`
            (label :text "PG"))
          (button :class "vpn-country-btn misc" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh NZ`
            (label :text "NZ"))
          (button :class "vpn-country-btn misc" :hexpand true
                  :onclick `~/.config/eww/scripts/vpn-connect.sh AU`
            (label :text "AU")))))))

; ── Audio + Media popup ───────────────────────────────────────────────────────

(defwindow audio
  :monitor 0
  :geometry (geometry :x "-8px" :y "34px" :anchor "top right" :width "280px")
  :stacking "fg"
  :focusable false
  (audio-menu))

(defwidget audio-menu []
  (box :class "bt-menu" :orientation "v" :spacing 10 :space-evenly false

    ; Volume row
    (box :orientation "h" :spacing 10 :space-evenly false :valign "center"
      (button :class {volume-data.muted ? "vol-icon-btn muted" : "vol-icon-btn"}
              :valign "center"
              :onclick `wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle`
        (label :class "nerd" :text {volume-data.icon}))
      (scale :hexpand true :min 0 :max 150 :value {volume-data.volume}
             :onchange `wpctl set-volume @DEFAULT_AUDIO_SINK@ {}%`)
      (label :class "vol-pct" :text {volume-data.percent} :valign "center"))

    (box :class "separator")

    ; No player
    (label :visible {!media-data.has_player} :class "no-devices"
           :text "Nothing playing" :halign "start")

    ; Media player
    (box :visible {media-data.has_player} :orientation "v" :spacing 8 :space-evenly false

      (box :orientation "v" :spacing 2 :hexpand true :valign "center" :space-evenly false
        (label :class "media-title" :text {media-data.title}
               :halign "start" :limit-width 28)
        (label :class "media-artist" :text {media-data.artist}
               :halign "start" :limit-width 32))

      (box :orientation "v" :spacing 2 :space-evenly false
        (scale :min 0 :max 100 :value {media-data.progress}
               :onchange `~/.config/eww/scripts/media-seek.sh {}`)
        (box :orientation "h" :space-evenly false
          (label :class "media-time" :text {media-data.position_str})
          (label :class "media-time" :text {media-data.length_str}
                 :hexpand true :halign "end")))

      (box :orientation "h" :spacing 8 :halign "center" :space-evenly false
        (button :class "control-btn" :valign "center"
                :onclick `playerctl previous`
          (label :class "nerd" :text "󰒮"))
        (button :class "control-btn play-btn" :valign "center"
                :onclick `playerctl play-pause`
          (label :class "nerd" :text {media-data.status_icon}))
        (button :class "control-btn" :valign "center"
                :onclick `playerctl next`
          (label :class "nerd" :text "󰒭"))))))
